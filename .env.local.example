# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard do Supabase > Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key

# Server-only: usada para encriptar/decriptar arquivos (comprovantes,
# documentos) antes do upload. Gere com `openssl rand -base64 32`.
DOCS_ENCRYPTION_KEY=

# Server-only: usadas pra mandar o e-mail de convite de verdade, via SMTP
# do Gmail (sem custo, sem precisar de domínio próprio). GMAIL_USER é o
# seu endereço @gmail.com; GMAIL_APP_PASSWORD é uma "senha de app" gerada
# em myaccount.google.com/apppasswords (não é a senha normal da conta —
# exige verificação em duas etapas ativada). Veja o passo a passo no README.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Ainda não implementado — convite por WhatsApp continua simulado.
# WHATSAPP_CLOUD_API_TOKEN=
