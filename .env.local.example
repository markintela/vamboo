# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard do Supabase > Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key

# Server-only: usada para encriptar/decriptar arquivos (comprovantes,
# documentos) antes do upload. Gere com `openssl rand -base64 32`.
DOCS_ENCRYPTION_KEY=

# Server-only: usada pra mandar o e-mail de convite de verdade (via Resend).
# Veja o passo a passo no README pra criar essa chave.
RESEND_API_KEY=
# Opcional: remetente do e-mail de convite. Sem domínio verificado no Resend,
# use o padrão de teste "onboarding@resend.dev" (só entrega pro e-mail da
# sua própria conta Resend). Com domínio verificado, troque por algo como
# "Vamboo <convites@seudominio.com>".
RESEND_FROM_EMAIL=Vamboo <onboarding@resend.dev>

# Ainda não implementado — convite por WhatsApp continua simulado.
# WHATSAPP_CLOUD_API_TOKEN=
